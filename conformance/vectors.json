  "cases": [
    {
      "id": "exact-match-allow",
      "why": "The ordinary case. An explicitly listed, granted, unflagged act allows, and the only reason returned is the resolved tier.",
      "bundle": "standard",
      "pdp_state": "normal",
      "tool_name": "email.list_campaigns",
      "expect": {
        "decision": "allow",
        "tier": "velocity",
        "requires_approval": false,
        "reasons": [
          "tier:velocity"
        ],
        "category": null
      }
    },
    {
      "id": "exact-match-flagged-requires-approval",
      "why": "An explicit requires_approval flag gates the act regardless of tier.",
      "bundle": "standard",
      "pdp_state": "normal",
      "tool_name": "email.send_now",
      "expect": {
        "decision": "require_approval",
        "tier": "efficiency",
        "requires_approval": true,
        "reasons": [
          "tier:efficiency",
          "requires_approval"
        ],
        "category": null
      }
    },
    {
      "id": "control-tier-without-flag-still-gates",
      "why": "THE DIVERGENCE THIS SUITE EXISTS FOR. An act at the control tier requires approval even when its requires_approval flag is false. Both Python evaluators previously got this wrong, allowing outright what the TypeScript evaluators gated. Latent only because no act had ever been control-without-flag; the moment tiers are derived from process characteristics rather than typed by hand, this becomes the normal case.",
      "bundle": "standard",
      "pdp_state": "normal",
      "tool_name": "reports.generate",
      "expect": {
        "decision": "require_approval",
        "tier": "control",
        "requires_approval": true,
        "reasons": [
          "tier:control",
          "requires_approval"
        ],
        "category": null
      }
    },
    {
      "id": "default-tier-control-escalates-a-velocity-act",
      "why": "Tier resolution is most-restrictive-wins across the bundle default and the act, so a control default gates an act labelled velocity. The same rule the previous case tests, reached through the default instead.",
      "bundle": "default_control",
      "pdp_state": "normal",
      "tool_name": "notes.append",
      "expect": {
        "decision": "require_approval",
        "tier": "control",
        "requires_approval": true,
        "reasons": [
          "tier:control",
          "requires_approval"
        ],
        "category": null
      }
    },
    {
      "id": "not-granted-denies",
      "why": "An act present in policy but not granted denies, reports its own tier rather than a synthetic one, and always sets requires_approval.",
      "bundle": "standard",
      "pdp_state": "normal",
      "tool_name": "contacts.delete",
      "expect": {
        "decision": "deny",
        "tier": "control",
        "requires_approval": true,
        "reasons": [
          "not_granted",
          "tool:contacts.delete"
        ],
        "category": null
      }
    },
    {
      "id": "unknown-act-denies-as-control",
      "why": "An act with no exact entry denies. The reported tier is control regardless of the bundle default, because an unknown act is the most restrictive case there is.",
      "bundle": "standard",
      "pdp_state": "normal",
      "tool_name": "billing.refund",
      "expect": {
        "decision": "deny",
        "tier": "control",
        "requires_approval": true,
        "reasons": [
          "unknown_tool",
          "tool:billing.refund"
        ],
        "category": null
      }
    },
    {
      "id": "unlisted-act-ignores-tool-categories",
      "why": "tool_categories no longer answers for anything. This bundle still carries analytics.read, which the old verb guess would have matched for get_summary; the act is unlisted, so it denies as unknown. Hosts must not keep a category fallback of their own.",
      "bundle": "standard",
      "pdp_state": "normal",
      "tool_name": "analytics.get_summary",
      "expect": {
        "decision": "deny",
        "tier": "control",
        "requires_approval": true,
        "reasons": [
          "unknown_tool",
          "tool:analytics.get_summary"
        ],
        "category": null
      }
    },
    {
      "id": "unlisted-act-is-unknown-not-refused-by-category",
      "why": "A category that withheld its grant used to answer not_granted. With categories inert the act is simply unlisted, and the reason says so.",
      "bundle": "standard",
      "pdp_state": "normal",
      "tool_name": "vault.get_secret",
      "expect": {
        "decision": "deny",
        "tier": "control",
        "requires_approval": true,
        "reasons": [
          "unknown_tool",
          "tool:vault.get_secret"
        ],
        "category": null
      }
    },
    {
      "id": "domainless-act-matches-exactly",
      "why": "Hermes-native act names carry no domain at all, and many real-world act names are this shape. An exact entry must still match.",
      "bundle": "standard",
      "pdp_state": "normal",
      "tool_name": "hermes_native_act",
      "expect": {
        "decision": "allow",
        "tier": "velocity",
        "requires_approval": false,
        "reasons": [
          "tier:velocity"
        ],
        "category": null
      }
    },
    {
      "id": "domainless-act-cannot-fall-back",
      "why": "An unlisted name with no dot denies as unknown. It must not crash.",
      "bundle": "standard",
      "pdp_state": "normal",
      "tool_name": "undeclared_native_act",
      "expect": {
        "decision": "deny",
        "tier": "control",
        "requires_approval": true,
        "reasons": [
          "unknown_tool",
          "tool:undeclared_native_act"
        ],
        "category": null
      }
    },
    {
      "id": "trailing-dot-denies",
      "why": "A malformed name matches nothing and denies. Nothing splits it.",
      "bundle": "standard",
      "pdp_state": "normal",
      "tool_name": "malformed.",
      "expect": {
        "decision": "deny",
        "tier": "control",
        "requires_approval": true,
        "reasons": [
          "unknown_tool",
          "tool:malformed."
        ],
        "category": null
      }
    },
    {
      "id": "multi-segment-act-matches-exactly",
      "why": "Names are matched whole, never split, so a listed multi-segment name matches.",
      "bundle": "standard",
      "pdp_state": "normal",
      "tool_name": "deep.nested.act",
      "expect": {
        "decision": "allow",
        "tier": "velocity",
        "requires_approval": false,
        "reasons": [
          "tier:velocity"
        ],
        "category": null
      }
    },
    {
      "id": "multi-segment-unlisted-denies",
      "why": "An unlisted multi-segment name denies. No split of it is ever tried.",
      "bundle": "standard",
      "pdp_state": "normal",
      "tool_name": "analytics.search.daily",
      "expect": {
        "decision": "deny",
        "tier": "control",
        "requires_approval": true,
        "reasons": [
          "unknown_tool",
          "tool:analytics.search.daily"
        ],
        "category": null
      }
    },
    {
      "id": "missing-categories-object-denies-cleanly",
      "why": "A bundle with no tool_categories at all denies an unlisted act cleanly.",
      "bundle": "no_categories",
      "pdp_state": "normal",
      "tool_name": "email.get_campaigns",
      "expect": {
        "decision": "deny",
        "tier": "control",
        "requires_approval": true,
        "reasons": [
          "unknown_tool",
          "tool:email.get_campaigns"
        ],
        "category": null
      }
    },
    {
      "id": "fail-closed-denies-before-any-lookup",
      "why": "In fail_closed the act is never resolved. Even an explicitly granted act denies, and the single reason is the state.",
      "bundle": "standard",
      "pdp_state": "fail_closed",
      "tool_name": "email.list_campaigns",
      "expect": {
        "decision": "deny",
        "tier": "control",
        "requires_approval": true,
        "reasons": [
          "pdp_fail_closed"
        ],
        "category": null
      }
    },
    {
      "id": "grace-state-allows-and-says-so",
      "why": "Inside the grace window the decision still stands, but the reasons must disclose it so a host can surface degraded governance. Both Python evaluators omitted this.",
      "bundle": "standard",
      "pdp_state": "grace",
      "tool_name": "email.list_campaigns",
      "expect": {
        "decision": "allow",
        "tier": "velocity",
        "requires_approval": false,
        "reasons": [
          "tier:velocity",
          "grace_period"
        ],
        "category": null
      }
    },
    {
      "id": "cached-state-allows-and-says-so",
      "why": "Same disclosure requirement when serving a cached bundle after a failed refresh.",
      "bundle": "standard",
      "pdp_state": "cached",
      "tool_name": "email.list_campaigns",
      "expect": {
        "decision": "allow",
        "tier": "velocity",
        "requires_approval": false,
        "reasons": [
          "tier:velocity",
          "using_cached_bundle"
        ],
        "category": null
      }
    },
    {
      "id": "grace-state-with-approval-orders-reasons",
      "why": "Pins reason ordering when several apply: tier first, then state, then the approval marker. Ordering matters because hosts match on position in logs and some parse reasons[0].",
      "bundle": "standard",
      "pdp_state": "grace",
      "tool_name": "email.send_now",
      "expect": {
        "decision": "require_approval",
        "tier": "efficiency",
        "requires_approval": true,
        "reasons": [
          "tier:efficiency",
          "grace_period",
          "requires_approval"
        ],
        "category": null
      }
    },
    {
      "id": "deny-reasons-ignore-state",
      "why": "Deny paths report why the act was refused, not what state the PDP was in. A cached bundle must not add noise to an unknown-act denial.",
      "bundle": "standard",
      "pdp_state": "cached",
      "tool_name": "billing.refund",
      "expect": {
        "decision": "deny",
        "tier": "control",
        "requires_approval": true,
        "reasons": [
          "unknown_tool",
          "tool:billing.refund"
        ],
        "category": null
      }
    },
    {
      "id": "prefixed-name-does-not-reach-dotted-entry",
      "why": "Names are not parsed. PromptForge compiles each policy entry into the exact names each host sends, so a host name reaches only an entry published under that name. A dotted entry is not a fallback for mcp__server__domain_action.",
      "bundle": "standard",
      "pdp_state": "normal",
      "tool_name": "mcp__example_server__email_list_campaigns",
      "expect": {
        "decision": "deny",
        "tier": "control",
        "requires_approval": true,
        "reasons": [
          "unknown_tool",
          "tool:mcp__example_server__email_list_campaigns"
        ],
        "category": null
      }
    },
    {
      "id": "prefixed-exact-entry-matches",
      "why": "The host's exact name is the only key it reaches, even when a dotted entry for the same action says otherwise.",
      "bundle": "prefixed_exact",
      "pdp_state": "normal",
      "tool_name": "mcp__example_server__email_send_now",
      "expect": {
        "decision": "allow",
        "tier": "velocity",
        "requires_approval": false,
        "reasons": [
          "tier:velocity"
        ],
        "category": null
      }
    },
    {
      "id": "single-underscore-spelling-denies",
      "why": "An unlisted spelling denies like any other unlisted name.",
      "bundle": "standard",
      "pdp_state": "normal",
      "tool_name": "mcp_example_server_email_send_now",
      "expect": {
        "decision": "deny",
        "tier": "control",
        "requires_approval": true,
        "reasons": [
          "unknown_tool",
          "tool:mcp_example_server_email_send_now"
        ],
        "category": null
      }
    },
    {
      "id": "unlisted-prefixed-act-denies",
      "why": "A prefixed name that is not listed denies as unknown.",
      "bundle": "no_categories",
      "pdp_state": "normal",
      "tool_name": "mcp__example_server__vault_read_secret",
      "expect": {
        "decision": "deny",
        "tier": "control",
        "requires_approval": true,
        "reasons": [
          "unknown_tool",
          "tool:mcp__example_server__vault_read_secret"
        ],
        "category": null
      }
    },
    {
      "id": "declared-group-on-prefixed-act",
      "why": "A host-sent name carries the group the policy declared. This is the case that never worked: the grain used to be parsed out of the act name, and no name a host sends has the dot that parse needed.",
      "bundle": "declared_groups",
      "pdp_state": "normal",
      "tool_name": "mcp__example_server__email_send_now",
      "expect": {
        "decision": "require_approval",
        "tier": "efficiency",
        "requires_approval": true,
        "reasons": [
          "tier:efficiency",
          "requires_approval"
        ],
        "category": "email.write"
      }
    },
    {
      "id": "declared-group-shared-across-acts",
      "why": "A second act in the same group returns the same key, which is what lets one approval cover a chain instead of prompting per act.",
      "bundle": "declared_groups",
      "pdp_state": "normal",
      "tool_name": "mcp__example_server__email_test_send",
      "expect": {
        "decision": "require_approval",
        "tier": "efficiency",
        "requires_approval": true,
        "reasons": [
          "tier:efficiency",
          "requires_approval"
        ],
        "category": "email.write"
      }
    },
    {
      "id": "declared-group-on-native-act",
      "why": "`write_file` has no domain and no action, so no naming rule could ever place it in a group. Declaring it works anyway \u2014 the point of moving the grain off the name.",
      "bundle": "declared_groups",
      "pdp_state": "normal",
      "tool_name": "write_file",
      "expect": {
        "decision": "require_approval",
        "tier": "efficiency",
        "requires_approval": true,
        "reasons": [
          "tier:efficiency",
          "requires_approval"
        ],
        "category": "native.file"
      }
    },
    {
      "id": "no-declared-group-stands-alone",
      "why": "An entry that declares no group returns null, and the host approves that act on its own. Grain is opt-in; omitting it must never widen an approval.",
      "bundle": "declared_groups",
      "pdp_state": "normal",
      "tool_name": "terminal",
      "expect": {
        "decision": "require_approval",
        "tier": "control",
        "requires_approval": true,
        "reasons": [
          "tier:control",
          "requires_approval"
        ],
        "category": null
      }
    },
    {
      "id": "declared-group-survives-refusal",
      "why": "A refused act still reports its group, so a host can say which group the refusal belongs to. The refusal itself is unchanged.",
      "bundle": "declared_groups",
      "pdp_state": "normal",
      "tool_name": "mcp__example_server__email_delete_all",
      "expect": {
        "decision": "deny",
        "tier": "control",
        "requires_approval": true,
        "reasons": [
          "not_granted",
          "tool:mcp__example_server__email_delete_all"
        ],
        "category": "email.write"
      }
    },
    {
      "id": "declared-group-beats-what-the-name-implies",
      "why": "The old parse would have called `analytics.get_report` a read in group `analytics.read`. The declaration says `reporting.sensitive` and wins. Names carry no authority over grouping.",
      "bundle": "declared_groups",
      "pdp_state": "normal",
      "tool_name": "analytics.get_report",
      "expect": {
        "decision": "require_approval",
        "tier": "efficiency",
        "requires_approval": true,
        "reasons": [
          "tier:efficiency",
          "requires_approval"
        ],
        "category": "reporting.sensitive"
      }
    },
    {
      "id": "unknown-act-has-no-group",
      "why": "An act the bundle does not list is refused with no group, because there is no entry to have declared one.",
      "bundle": "declared_groups",
      "pdp_state": "normal",
      "tool_name": "mcp__example_server__email_unlisted",
      "expect": {
        "decision": "deny",
        "tier": "control",
        "requires_approval": true,
        "reasons": [
          "unknown_tool",
          "tool:mcp__example_server__email_unlisted"
        ],
        "category": null
      }
    },
    {
      "id": "fail-closed-has-no-group",
      "why": "With no usable bundle there is no entry and therefore no group. A refusal must never be widened into a group approval.",
      "bundle": "declared_groups",
      "pdp_state": "fail_closed",
      "tool_name": "mcp__example_server__email_send_now",
      "expect": {
        "decision": "deny",
        "tier": "control",
        "requires_approval": true,
        "reasons": [
          "pdp_fail_closed"
        ],
        "category": null
      }
    },
    {
      "id": "empty-group-string-is-no-group",
      "why": "An empty group must read as absent, not as a group named \"\" that every cleared act would share. The two languages disagree here by default, so this is vectored rather than left to each implementation.",
      "bundle": "declared_groups",
      "pdp_state": "normal",
      "tool_name": "mcp__example_server__email_get_inbox",
      "expect": {
        "decision": "require_approval",
        "tier": "efficiency",
        "requires_approval": true,
        "reasons": [
          "tier:efficiency",
          "requires_approval"
        ],
        "category": null
      }
    }
